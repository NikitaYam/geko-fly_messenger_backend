# Скопируйте в .env и заполните. Без этих переменных docker compose не стартует.
# Профиль Spring задаётся в docker-compose.yml (prod), здесь его настраивать не нужно.
JWT_SECRET=замените-на-длинный-случайный-ключ-минимум-32-символа
ADMIN_LOGIN=замените-на-логин-супер-админа
ADMIN_PASSWORD=замените-на-надёжный-пароль
ADMIN_DISPLAY_NAME=Administrator
